# OS / editor junk
.DS_Store
**/.DS_Store
*.swp
.idea/
.vscode/

# Secrets — never commit real env files (commit only *.env.example)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output / deps (also covered per-app, kept here as a safety net)
node_modules/
dist/
.next/
out/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
