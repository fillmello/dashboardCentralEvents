# Database — local docker default (see docker-compose.yml); in production set a
# real connection string via the host's secret manager, never commit it.
DATABASE_URL=postgresql://postgres:festa123@localhost:5432/festa_multiplicacao
DB_SYNCHRONIZE=true

# Seed the event programação (cronograma) on boot when the schedule is empty.
# Set to "false" to disable. No user accounts are ever seeded.
SEED_ON_BOOT=true

# App
NODE_ENV=development
PORT=5000
TZ=America/Sao_Paulo

# Security — generate a long random secret for each environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=36000
JWT_REFRESH_EXPIRATION=259200

# CORS (comma-separated origins; also used by the WebSocket gateway)
CORS_ORIGIN=http://localhost:3000
